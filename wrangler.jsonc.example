{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iran-news-worker-demo",
  "main": "worker.js",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iran-news-demo",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "AI_PROVIDER_ORDER": "gemini,cloudflare,groq",
    "AI_MAX_KEYS_PER_PROVIDER": "2",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "GEMINI_THINKING_LEVEL": "low",
    "CLOUDFLARE_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "CLOUDFLARE_AI_ENABLE_THINKING": "false",
    "DIAGNOSTIC_REPORT_HOUR": "22",
    "DIAGNOSTIC_TIMEZONE_OFFSET_MINUTES": "210",
    "CRON_QUEUE_BATCH": "1",
    "CRON_SOURCE_BATCH": "1",
    "CRON_ITEMS_PER_SOURCE": "1",
    "SOURCE_AUTO_RESUME_MINUTES": "30"
  }
}
